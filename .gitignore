# C++ Visual Studio .gitignore

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Visual Studio specific
.vs/
*.user
*.userosscache
*.sln.docstates
*.suo
*.dbmdl
*.jfm
*.pnc

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]uild/
bld/
[Bb]in/
[Oo]bj/

# Intellisense
*.ipch
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cache
*.db

# Other
*.log
*.tlog
*.lastbuildstate
